diff --git a/board/nxp/lx2160a/lx2160ardb_onie.env b/board/nxp/lx2160a/lx2160ardb_onie.env
new file mode 100644
index 00000000..c327cc54
--- /dev/null
+++ b/board/nxp/lx2160a/lx2160ardb_onie.env
@@ -0,0 +1,36 @@
+/*
+ * LX2160ARDB default environment for ONIE (XSPI NOR boot only).
+ *
+ * NOR chip 0: firmware up to 0xf00000, U-Boot env at 0x500000, ONIE FIT at
+ * 0x1000000 (16 MiB minus the hw-info sector at 0x1fe0000, which holds the
+ * ONIE TlvInfo system EEPROM). fsl_bootcmd_mcinitcmd_set keeps the board
+ * code from replacing bootcmd and mcinitcmd at start-up, so both are defined
+ * (mcinitcmd = XSPI_MC_INIT_CMD; bootcmd is CONFIG_BOOTCOMMAND in
+ * lx2160ardb_tfa_onie_defconfig). A network OS installs itself by setting
+ * nos_bootcmd; "run onie_rescue/onie_update/onie_uninstall" boot ONIE in
+ * those modes.
+ */
+fsl_bootcmd_mcinitcmd_set=y
+mcinitcmd=sf probe 0:0 && sf read 0x80640000 0x640000 0x80000 && sf read $fdt_addr_r 0xf00000 0x100000 && env exists secureboot && esbc_validate 0x80640000 && esbc_validate 0x80680000; sf read 0x80a00000 0xa00000 0x300000 && sf read 0x80e00000 0xe00000 0x100000; fsl_mc start mc 0x80a00000 0x80e00000
+
+consoledev=ttyAMA0
+onie_platform=arm64-nxp_lx2160ardb-r0
+onie_machine=nxp_lx2160ardb
+onie_machine_rev=0
+onie_arch=arm64
+onie_start=0x1000000
+onie_sz.b=0xfe0000
+loadaddr=0xa0000000
+/* DPAA2 layout from NOR, applied at bootm (kernel loads above it) */
+lx2160_dpl=sf probe 0:0; sf read 0x80d00000 0xd00000 0x100000; fsl_mc lazyapply dpl 0x80d00000
+
+nos_bootcmd=echo
+onie_bootcmd=echo Loading Open Network Install Environment ...; echo Platform: $onie_platform; echo Version : $onie_version; sf probe 0:0 && sf read $loadaddr $onie_start ${onie_sz.b} && run lx2160_dpl && run onie_args && bootm ${loadaddr}
+onie_initargs=setenv bootargs quiet console=$consoledev,$baudrate earlycon
+onie_platformargs=setenv bootargs $bootargs serial_num=${serial#} eth_addr=$ethaddr $onie_bootargs $onie_debugargs
+onie_args=run onie_initargs onie_platformargs
+check_boot_reason=if test -n $onie_boot_reason; then setenv onie_bootargs boot_reason=$onie_boot_reason; run onie_bootcmd; fi;
+onie_rescue=setenv onie_boot_reason rescue && boot
+onie_update=setenv onie_boot_reason update && boot
+onie_uninstall=setenv onie_boot_reason uninstall && boot
+debian_boot=sf probe 0:0; sf read 0x806c0000 0x6c0000 0x40000; env exists mcinitcmd && env exists secureboot && esbc_validate 0x806c0000; sf read 0x80d00000 0xd00000 0x100000; env exists mcinitcmd && fsl_mc lazyapply dpl 0x80d00000; run distro_bootcmd;run xspi_bootcmd; env exists secureboot && esbc_halt;
