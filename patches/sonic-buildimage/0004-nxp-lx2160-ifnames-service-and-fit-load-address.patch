--- a/platform/nxp-lx2160/sonic-platform-nxp/systemd/lx2160-mgmt-eth0.service	1969-12-31 18:00:00.000000000 -0600
+++ b/platform/nxp-lx2160/sonic-platform-nxp/systemd/lx2160-mgmt-eth0.service	2026-11-22 07:39:51.174384240 -0600
@@ -0,0 +1,15 @@
+[Unit]
+Description=Apply the LX2160ARDB DPAA2 interface names (dpmacNN, eth0)
+DefaultDependencies=no
+After=systemd-udev-settle.service systemd-udev-trigger.service
+Wants=systemd-udev-settle.service
+Before=network-pre.target config-setup.service interfaces-config.service
+Wants=network-pre.target
+
+[Service]
+Type=oneshot
+ExecStart=/bin/sh /usr/bin/lx2160-mgmt-eth0
+RemainAfterExit=yes
+
+[Install]
+WantedBy=sysinit.target
