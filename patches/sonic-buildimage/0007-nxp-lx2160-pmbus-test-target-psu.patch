@@ -0,0 +1,34 @@
+#!/usr/bin/python3
+# Lab setup only: bind the kernel pmbus driver to the FRDM-MCXA153 PMBus test
+# target (MFR_MODEL "MCXA153-PMB-1", address 0x58) when it sits behind the
+# board's 0x77 mux, channel 7. Boards without it are left alone: one read of
+# an otherwise unused address, then nothing.
+import glob
+import os
+import subprocess
+import sys
+
+from smbus2 import SMBus
+
+ADDR = 0x58
+MFR_MODEL = 0x9a
+MODEL = b"MCXA153-PMB-1"
+
+chans = glob.glob("/sys/bus/i2c/devices/*-0077/channel-7")
+if not chans:
+    sys.exit(0)
+adapter = os.path.basename(os.path.realpath(chans[0]))  # i2c-N
+bus = int(adapter.split("-")[1])
+if os.path.exists("/sys/bus/i2c/devices/%d-%04x" % (bus, ADDR)):
+    sys.exit(0)  # already bound
+try:
+    with SMBus(bus) as b:
+        data = bytes(b.read_i2c_block_data(ADDR, MFR_MODEL, 1 + len(MODEL)))
+except OSError:
+    sys.exit(0)  # nothing there
+if data[0] != len(MODEL) or data[1:] != MODEL:
+    sys.exit(0)  # some other device
+subprocess.run(["modprobe", "pmbus"], check=False)
+with open("/sys/bus/i2c/devices/%s/new_device" % adapter, "w") as f:
+    f.write("pmbus 0x%02x\n" % ADDR)
+print("lx2160-pmbus-test: PMBus test target on %s, pmbus driver bound" % adapter)
