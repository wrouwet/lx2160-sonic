--- a/platform/nxp-lx2160/sonic-platform-nxp/sonic_platform/psu.py	1969-12-31 18:00:00.000000000 -0600
+++ b/platform/nxp-lx2160/sonic-platform-nxp/sonic_platform/psu.py	2026-11-23 12:25:05.385394155 -0600
@@ -0,0 +1,178 @@
+# PMBus test target as a PSU. The reference board has no PSU under SONiC's
+# control; this exists only for a lab setup with an FRDM-MCXA153 PMBus target
+# (model MCXA153-PMB-1) at 0x58 behind the board's 0x77 mux, channel 7.
+# lx2160-pmbus-test binds the kernel pmbus driver to it at boot when present;
+# without that hwmon device the chassis has no PSUs.
+from sonic_platform_base.psu_base import PsuBase
+from sonic_platform_base.thermal_base import ThermalBase
+from sonic_platform.thermal import _find_hwmon, _read
+
+HWMON_NAME = "pmbus"
+ADDR = "0058"
+MODEL = "MCXA153-PMB-1"
+
+
+def present():
+    return _find_hwmon(HWMON_NAME, ADDR) is not None
+
+
+class _Hwmon(object):
+    def __init__(self):
+        self._path = None
+
+    def value(self, attr, scale=1000.0):
+        if self._path is None:
+            self._path = _find_hwmon(HWMON_NAME, ADDR)
+            if self._path is None:
+                return None
+        v = _read(self._path + "/" + attr)
+        try:
+            return int(v) / scale
+        except (TypeError, ValueError):
+            self._path = None
+            return None
+
+
+class PsuThermal(ThermalBase):
+    def __init__(self, hwmon, chan, name):
+        ThermalBase.__init__(self)
+        self._hwmon = hwmon
+        self._chan = chan
+        self.name = name
+        self.minimum_thermal = None
+        self.maximum_thermal = None
+
+    def get_name(self):
+        return self.name
+
+    def get_presence(self):
+        return self.get_temperature() is not None
+
+    def get_model(self):
+        return MODEL
+
+    def get_serial(self):
+        return "N/A"
+
+    def get_status(self):
+        return self.get_presence()
+
+    def is_replaceable(self):
+        return False
+
+    def get_position_in_parent(self):
+        return self._chan
+
+    def get_temperature(self):
+        t = self._hwmon.value("temp%d_input" % self._chan)
+        if t is not None:
+            self.minimum_thermal = t if self.minimum_thermal is None else min(self.minimum_thermal, t)
+            self.maximum_thermal = t if self.maximum_thermal is None else max(self.maximum_thermal, t)
+        return t
+
+    def get_high_threshold(self):
+        t = self._hwmon.value("temp%d_max" % self._chan)
+        return t if t is not None else "N/A"
+
+    def get_high_critical_threshold(self):
+        t = self._hwmon.value("temp%d_crit" % self._chan)
+        return t if t is not None else "N/A"
+
+    def get_low_threshold(self):
+        return "N/A"
+
+    def get_low_critical_threshold(self):
+        return "N/A"
+
+    def get_minimum_recorded(self):
+        return self.minimum_thermal
+
+    def get_maximum_recorded(self):
+        return self.maximum_thermal
+
+
+class Psu(PsuBase):
+    def __init__(self, index):
+        PsuBase.__init__(self)
+        self.index = index
+        self._hwmon = _Hwmon()
+        self._thermal_list = [
+            PsuThermal(self._hwmon, 1, "PSU %d Temp 1" % (index + 1)),
+            PsuThermal(self._hwmon, 2, "PSU %d Temp 2" % (index + 1)),
+        ]
+        self._status_led = self.STATUS_LED_COLOR_OFF
+
+    def get_name(self):
+        return "PSU %d (PMBus test target)" % (self.index + 1)
+
+    def get_presence(self):
+        return self._hwmon.value("in1_input") is not None
+
+    def get_model(self):
+        return MODEL
+
+    def get_serial(self):
+        return "N/A"
+
+    def get_revision(self):
+        return "N/A"
+
+    def get_status(self):
+        return self.get_powergood_status()
+
+    def is_replaceable(self):
+        return False
+
+    def get_position_in_parent(self):
+        return self.index + 1
+
+    # in1/curr1/power1: input; in2/curr2/power2: output (vout1)
+    def get_voltage(self):
+        return self._hwmon.value("in2_input")
+
+    def get_current(self):
+        return self._hwmon.value("curr2_input")
+
+    def get_power(self):
+        return self._hwmon.value("power2_input", 1000000.0)
+
+    def get_input_voltage(self):
+        return self._hwmon.value("in1_input")
+
+    def get_input_current(self):
+        return self._hwmon.value("curr1_input")
+
+    def get_powergood_status(self):
+        # present, output voltage up, and no alarm the pmbus driver reports
+        v = self.get_voltage()
+        if v is None or v <= 0:
+            return False
+        for attr in ("in2_lcrit_alarm", "in2_crit_alarm", "curr2_crit_alarm",
+                     "temp1_crit_alarm", "temp2_crit_alarm"):
+            if self._hwmon.value(attr, 1) == 1:
+                return False
+        return True
+
+    def get_temperature(self):
+        return self._thermal_list[0].get_temperature()
+
+    def get_temperature_high_threshold(self):
+        return self._thermal_list[0].get_high_threshold()
+
+    def get_voltage_high_threshold(self):
+        t = self._hwmon.value("in2_max")
+        return t if t is not None else "N/A"
+
+    def get_voltage_low_threshold(self):
+        t = self._hwmon.value("in2_min")
+        return t if t is not None else "N/A"
+
+    def get_maximum_supplied_power(self):
+        return "N/A"
+
+    def set_status_led(self, color):
+        self._status_led = color
+        return True
+
+    def get_status_led(self):
+        return self._status_led
