diff -ruN -x '*.pyc' -x __pycache__ -x build -x '*.egg-info' a/platform/nxp-lx2160/sonic-platform-nxp/scripts/lx2160-pmbus-test b/platform/nxp-lx2160/sonic-platform-nxp/scripts/lx2160-pmbus-test
--- a/platform/nxp-lx2160/sonic-platform-nxp/scripts/lx2160-pmbus-test	1969-12-31 18:00:00.000000000 -0600
