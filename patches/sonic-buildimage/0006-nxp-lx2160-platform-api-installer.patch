-# SONiC installer platform hooks for the NXP LX2160ARDB.
+# SONiC installer platform hooks for the NXP LX2160ARDB (U-Boot).
 #
-# Not implemented yet: this board has no ONIE, and the generic installer's
-# partitioning and U-Boot environment handling have not been adapted to it.
-# Refuse to install rather than let default_platform.conf partition a disk.
-# Bring-up installs the image by hand (lx2160-sonic: scripts/sonic-lx2160-install.sh,
-# then boot from U-Boot as described in docs/sonic-lx2160-bringup.md).
+# Keeps two images in the U-Boot environment the way sonic-installer's
+# U-Boot backend expects (sonic_version_1/2, sonic_image_1/2, boot_next,
+# boot_once, linuxargs). Each SONiC boot first applies the DPAA2 layout (DPL)
+# from NOR, like NXP's default bootcmd.
+#
+# Install paths:
+# - ONIE (onie-nos-install): wipes the eMMC, creates one SONiC-OS partition
+#   and hooks into ONIE's boot flow through nos_bootcmd; ONIE's own bootcmd
+#   (check_boot_reason, nos_bootcmd, onie_bootcmd) stays in place.
+# - SONiC (sonic-installer install): installs into /host.
+# - Another Linux on the board (lx2160-sonic: scripts/sonic-lx2160-install.sh)
+#   sources this file and calls lx2160_uboot_env. Without an ONIE
+#   environment (NXP's default one), the boot menu replaces bootcmd and NXP's
+#   bootcmd is kept as debian_boot.
+#
+# The U-Boot environment must be valid. With the ONIE U-Boot environment
+# (lx2160ardb_tfa_onie_defconfig) U-Boot saves it on first boot. With NXP's,
+# save it once at the U-Boot prompt after a normal start (not after
+# "env default -a"); libubootenv refuses to write a blank environment.
+
+VAR_LOG=512
+FW_ENV_CONFIG="/dev/mtd0 0x500000 0x10000 0x20000"
+FW_ENV_CONFIG_FILE=${FW_ENV_CONFIG_FILE:-/etc/fw_env.config}
+LX2160_FIT=/boot/sonic_arm64.fit
+LX2160_FIT_ADDR=0xa0000000
+LX2160_DPL='sf probe 0:0; sf read 0x80d00000 0xd00000 0x100000; fsl_mc lazyapply dpl 0x80d00000'
+# eMMC controller (esdhc1); the SD card slot is 2140000.mmc
+LX2160_EMMC_CTRL=2150000.mmc
+
+lx2160_emmc_dev()
+{
+    for b in /sys/block/mmcblk[0-9]*; do
+        case "$(readlink -f $b)" in
+        */$LX2160_EMMC_CTRL/*) echo /dev/$(basename $b); return 0 ;;
+        esac
+    done
+    return 1
+}
 
