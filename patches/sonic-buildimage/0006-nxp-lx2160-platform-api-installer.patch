--- a/platform/nxp-lx2160/sonic-platform-nxp/sonic_platform/chassis.py	1969-12-31 18:00:00.000000000 -0600
+++ b/platform/nxp-lx2160/sonic-platform-nxp/sonic_platform/chassis.py	2026-11-22 09:15:15.124740806 -0600
@@ -0,0 +1,53 @@
+# LX2160ARDB chassis: the board itself. It has no fans, PSUs or optics under
+# SONiC's control (an external BMC/switch board would own fans and PSUs);
+# what it does have is a system EEPROM (built in software, see eeprom.py),
+# temperature sensors (thermal.py) and the SoC watchdog (watchdog.py).
+from sonic_platform_base.chassis_base import ChassisBase
+from sonic_platform.eeprom import Eeprom
+from sonic_platform.thermal import THERMALS, Thermal
+from sonic_platform.watchdog import Watchdog
+
+MODEL = "LX2160ARDB"
+
+
+class Chassis(ChassisBase):
+    def __init__(self):
+        ChassisBase.__init__(self)
+        self._eeprom = Eeprom()
+        self._thermal_list = [Thermal(i) for i in range(len(THERMALS))]
+        self._watchdog = Watchdog()
+
+    def get_name(self):
+        return MODEL
+
+    def get_model(self):
+        return self._eeprom.modelstr()
+
+    def get_serial(self):
+        return self._eeprom.serial_number_str()
+
+    def get_base_mac(self):
+        return self._eeprom.base_mac_addr()
+
+    def get_system_eeprom_info(self):
+        return self._eeprom.get_eeprom_dict()
+
+    def get_presence(self):
+        return True
+
+    def get_status(self):
+        return True
+
+    def get_revision(self):
+        return "B"
+
+    def is_replaceable(self):
+        return False
+
+    def get_position_in_parent(self):
+        return -1
+
+    def get_reboot_cause(self):
+        # No reset-cause register is read yet; SONiC falls back to its
+        # software reboot-cause record.
+        return (self.REBOOT_CAUSE_NON_HARDWARE, None)
diff -ruN -x '*.pyc' -x __pycache__ a/platform/nxp-lx2160/sonic-platform-nxp/sonic_platform/eeprom.py b/platform/nxp-lx2160/sonic-platform-nxp/sonic_platform/eeprom.py
--- a/platform/nxp-lx2160/sonic-platform-nxp/sonic_platform/eeprom.py	1969-12-31 18:00:00.000000000 -0600
+++ b/platform/nxp-lx2160/sonic-platform-nxp/sonic_platform/eeprom.py	2026-11-22 09:15:15.125170484 -0600
@@ -0,0 +1,91 @@
+# System EEPROM for the LX2160ARDB.
+# The reference board has no ONIE TlvInfo EEPROM, so the TlvInfo image is
+# built in software from what the board does provide: the management port's
+# MAC address (dpni.1, eth0 under SONiC; found by device, not by name) as
+# the base MAC, and the SoC/board identity.
+# The image is written to a file and read back through the standard
+# TlvInfoDecoder path, so decode-syseeprom and syseepromd behave as on
+# hardware. Replace with the real EEPROM path on a product board.
+import glob
+import os
+import tempfile
+
+from sonic_platform_base.sonic_eeprom.eeprom_tlvinfo import TlvInfoDecoder
+
+EEPROM_FILE = "/tmp/lx2160ardb-syseeprom.bin"
+MGMT_DPNI = "dpni.1"
+
+
+def _read(path, default=""):
+    try:
+        with open(path) as f:
+            return f.read().strip().strip("\0")
+    except OSError:
+        return default
+
+
+def _mgmt_mac():
+    for a in glob.glob("/sys/bus/fsl-mc/devices/%s/net/*/address" % MGMT_DPNI):
+        return _read(a)
+    return "00:00:00:00:00:00"
+
+
+class Eeprom(TlvInfoDecoder):
+    def __init__(self):
+        self._build()
+        TlvInfoDecoder.__init__(self, EEPROM_FILE, 0, "", True)
+
+    def _fields(self):
+        soc = _read("/sys/devices/soc0/soc_id", "unknown")
+        rev = _read("/sys/devices/soc0/revision", "")
+        return [
+            (self._TLV_CODE_PRODUCT_NAME, "LX2160ARDB"),
+            (self._TLV_CODE_PART_NUMBER, "LX2160A-RDB"),
+            (self._TLV_CODE_SERIAL_NUMBER, "N/A"),
+            (self._TLV_CODE_MAC_BASE, _mgmt_mac()),
+            (self._TLV_CODE_DEVICE_VERSION, "2"),
+            (self._TLV_CODE_LABEL_REVISION, "B"),
+            (self._TLV_CODE_PLATFORM_NAME, "arm64-nxp_lx2160ardb-r0"),
+            (self._TLV_CODE_MAC_SIZE, "1"),
+            (self._TLV_CODE_MANUF_NAME, "NXP"),
+            (self._TLV_CODE_VENDOR_NAME, "NXP"),
+            (self._TLV_CODE_DIAG_VERSION, "%s rev %s" % (soc, rev)),
+        ]
+
+    def _build(self):
+        # TlvInfo header, TLVs, then the CRC-32 TLV over everything before it
+        tlvs = bytearray()
+        for code, value in self._fields():
+            tlvs += self.encoder((code,), value)
+        tlvs += bytearray([self._TLV_CODE_CRC_32, 4])
+        e = self._TLV_INFO_ID_STRING + bytearray([self._TLV_INFO_VERSION]) + \
+            bytearray([(len(tlvs) + 4) >> 8 & 0xFF, (len(tlvs) + 4) & 0xFF]) + tlvs
+        e += self.encode_checksum(self.calculate_checksum(e))
+        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(EEPROM_FILE))
+        with os.fdopen(fd, "wb") as f:
+            f.write(e)
+        os.chmod(tmp, 0o644)
+        os.replace(tmp, EEPROM_FILE)
+
+    def _e(self):
+        return self.read_eeprom()
+
+    def base_mac_addr(self, e=None):
+        return TlvInfoDecoder.base_mac_addr(self, e or self._e())
+
+    def modelstr(self, e=None):
+        return TlvInfoDecoder.modelstr(self, e or self._e())
+
+    def serial_number_str(self, e=None):
+        return TlvInfoDecoder.serial_number_str(self, e or self._e())
+
+    def get_eeprom_dict(self):
+        # {"0x21": "LX2160ARDB", ...}, values rendered as decode-syseeprom
+        # prints them
+        e = self._e()
+        result = {}
+        for code, _ in self._fields():
+            found, tlv = self.get_tlv_field(e, code)
+            if found:
+                result["0x%02X" % code] = self.decoder(None, bytearray([tlv[0], tlv[1]]) + tlv[2])[1]
+        return result
