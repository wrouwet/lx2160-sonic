+    lx2160_env_line sonic_image_1 "run lx2160_dpl; setenv bootargs \${sonic_root} \${linuxargs}; ${scan}ext4load $load \${fit_addr} /$img$LX2160_FIT; bootm \${fit_addr}" >> $script
+    lx2160_env_line print_menu "echo \"1: \$sonic_version_1 (run sonic_image_1)\"; echo \"2: \$sonic_version_2 (run sonic_image_2)\"; $menu3" >> $script
+    if [ -n "$onie" ]; then
+        # ONIE's bootcmd runs nos_bootcmd, then ONIE if that returns
+        lx2160_env_line nos_bootcmd "$select" >> $script
+    else
