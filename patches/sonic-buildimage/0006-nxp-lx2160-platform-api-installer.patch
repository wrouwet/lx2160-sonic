+# U-Boot "<interface> <dev>:<part>" for the partition holding $1 (a mount point)
+lx2160_uboot_part()
+{
+    blk=$(basename "$(lx2160_mnt_dev "$1")")
+    part=$(cat /sys/class/block/$blk/partition)
+    case $blk in
+    mmcblk*) echo "mmc $(echo $blk | sed 's/^mmcblk\([0-9]*\).*/\1/'):$part" ;;
+    *) echo "scsi 0:$part" ;;  # the board's single SATA disk
+    esac
+}
+
+# fw_setenv -s script line: libubootenv takes "name=value", U-Boot's own
+# fw_setenv (in ONIE) "name value"
+lx2160_env_line()
+{
+    if [ "$LX2160_ENV_SEP" = "=" ]; then
+        echo "$1=$2"
+    else
+        echo "$1 $2"
+    fi
+}
 
