+    lx2160_env_line lx2160_dpl "$LX2160_DPL" >> $script
+    lx2160_env_line fit_addr "$LX2160_FIT_ADDR" >> $script
+    lx2160_env_line sonic_root "root=UUID=$uuid rw rootwait panic=1 console=ttyAMA0,115200" >> $script
+    lx2160_env_line sonic_version_1 "$ver" >> $script
