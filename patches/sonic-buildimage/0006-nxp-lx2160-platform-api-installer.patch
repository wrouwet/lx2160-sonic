@@ -1,22 +1,110 @@
-# SONiC installer platform hooks for the NXP LX2160ARDB.
+# SONiC installer platform hooks for the NXP LX2160ARDB (U-Boot, no ONIE).
 #
-# Not implemented yet: this board has no ONIE, and the generic installer's
-# partitioning and U-Boot environment handling have not been adapted to it.
-# Refuse to install rather than let default_platform.conf partition a disk.
-# Bring-up installs the image by hand (lx2160-sonic: scripts/sonic-lx2160-install.sh,
-# then boot from U-Boot as described in docs/sonic-lx2160-bringup.md).
+# Installs from a running SONiC (sonic-installer install) into /host, and
+# keeps two images in the U-Boot environment the way sonic-installer's
+# U-Boot backend expects (sonic_version_1/2, sonic_image_1/2, boot_next,
+# boot_once, linuxargs). Each SONiC boot first applies the DPAA2 layout (DPL)
+# from NOR, like NXP's default bootcmd. NXP's original bootcmd is kept as
+# debian_boot (menu entry 3).
+#
+# The first install comes from another Linux on the board (lx2160-sonic:
+# scripts/sonic-lx2160-install.sh), which sources this file and calls
+# lx2160_uboot_env. There is no ONIE for this board yet, so an ONIE install
+# is refused rather than letting default_platform.conf partition a disk.
+#
+# The U-Boot environment must already be valid: saved once at the U-Boot
+# prompt after a normal start (not after "env default -a"), so that it holds
+# the bootcmd and mcinitcmd NXP's board code sets for XSPI boot, plus
+# fsl_bootcmd_mcinitcmd_set=y, without which U-Boot would overwrite bootcmd
+# on every start. libubootenv refuses to write a blank environment.
 
-lx2160_not_supported()
+VAR_LOG=512
+FW_ENV_CONFIG="/dev/mtd0 0x500000 0x2000 0x20000"
+FW_ENV_CONFIG_FILE=${FW_ENV_CONFIG_FILE:-/etc/fw_env.config}
+LX2160_FIT=/boot/sonic_arm64.fit
+LX2160_FIT_ADDR=0xa0000000
+LX2160_DPL='sf probe 0:0; sf read 0x80d00000 0xd00000 0x100000; fsl_mc lazyapply dpl 0x80d00000'
+
+# U-Boot "<interface> <dev>:<part>" for the partition holding $1 (a mount point)
+lx2160_uboot_part()
 {
-    echo "SONiC installer: the NXP LX2160ARDB installer is not implemented yet."
-    echo "Install manually, see docs/sonic-lx2160-bringup.md in lx2160-sonic."
-    exit 1
+    dev=$(findmnt -n -o SOURCE --target "$1")
+    blk=$(basename "$dev")
+    part=$(cat /sys/class/block/$blk/partition)
+    case $blk in
+    mmcblk*) echo "mmc $(echo $blk | sed 's/^mmcblk\([0-9]*\).*/\1/'):$part" ;;
+    *) echo "scsi 0:$part" ;;  # the board's single SATA disk
+    esac
 }
 
-create_partition()      { lx2160_not_supported; }
-mount_partition()       { lx2160_not_supported; }
-bootloader_menu_config() { lx2160_not_supported; }
+# lx2160_uboot_env <mount point> <image dir> <image version> <default|once>
+# Installs the image into slot 1 (the previous slot-1 image moves to slot 2)
+# and boots it always (default) or on the next boot only (once).
+lx2160_uboot_env()
+{
+    mnt=$1 img=$2 ver=$3 mode=$4
+
+    [ -f $FW_ENV_CONFIG_FILE ] || echo "$FW_ENV_CONFIG" > $FW_ENV_CONFIG_FILE
+    # (libubootenv's fw_printenv -n exits 0 for unset variables: test output)
+    if [ -z "$(fw_printenv -n bootcmd 2>/dev/null)" ]; then
+        echo "ERROR: no valid U-Boot environment (save it once: stop autoboot, then saveenv at the U-Boot prompt)"
+        return 1
+    fi
+
+    uuid=$(findmnt -n -o UUID --target "$mnt")
+    set -- $(lx2160_uboot_part "$mnt")
+    load="$1 $2"
+    scan=""
+    [ "$1" = scsi ] && scan="scsi scan; "
+
+    script=$(mktemp)
+    # NXP's bootcmd becomes debian_boot, once
+    [ -n "$(fw_printenv -n debian_boot 2>/dev/null)" ] ||
+        echo "debian_boot=$(fw_printenv -n bootcmd)" >> $script
 
-if [ "$install_env" != "build" ]; then
-    lx2160_not_supported
+    old_ver=$(fw_printenv -n sonic_version_1 2>/dev/null || true)
+    if [ -n "$old_ver" ] && [ "$old_ver" != "$ver" ] && [ "$old_ver" != NONE ]; then
+        cat >> $script <<EOF
+sonic_version_2=$old_ver
+linuxargs_2=$(fw_printenv -n linuxargs)
+sonic_bootargs_2=$(fw_printenv -n sonic_bootargs_1 | sed 's/\${linuxargs}/${linuxargs_2}/')
+sonic_boot_load_2=$(fw_printenv -n sonic_boot_load_1)
+EOF
+    fi
+
+    cat >> $script <<EOF
+lx2160_dpl=$LX2160_DPL
+fit_addr=$LX2160_FIT_ADDR
+sonic_version_1=$ver
+linuxargs=net.ifnames=0 loopfstype=squashfs loop=$img/fs.squashfs varlog_size=$VAR_LOG ${ONIE_PLATFORM_EXTRA_CMDLINE_LINUX}
+sonic_bootargs_1=setenv bootargs root=UUID=$uuid rw rootwait panic=1 console=ttyAMA0,115200 \${linuxargs}
+sonic_boot_load_1=${scan}ext4load $load \${fit_addr} /$img$LX2160_FIT
+sonic_image_1=run lx2160_dpl; run sonic_bootargs_1; run sonic_boot_load_1; bootm \${fit_addr}
+sonic_image_2=run lx2160_dpl; run sonic_bootargs_2; run sonic_boot_load_2; bootm \${fit_addr}
+print_menu=echo "---------------------------------------------------"; echo " > Boot1: \$sonic_version_1 - run sonic_image_1"; echo " > Boot2: \$sonic_version_2 - run sonic_image_2"; echo " > Boot3: Debian/NXP default - run debian_boot"; echo "---------------------------------------------------"
+bootcmd=run print_menu; test -n "\$boot_once" && setenv do_boot_once "\$boot_once" && setenv boot_once "" && saveenv && run do_boot_once; run boot_next
+EOF
+    if [ "$mode" = default ]; then
+        echo "boot_next=run sonic_image_1" >> $script
+    else
+        [ -n "$(fw_printenv -n boot_next 2>/dev/null)" ] || echo "boot_next=run debian_boot" >> $script
+        echo "boot_once=run sonic_image_1" >> $script
+    fi
+    fw_setenv -s $script
+    rc=$?
+    rm -f $script
+    return $rc
+}
+
+if [ "$install_env" = "onie" ]; then
+    echo "SONiC installer: there is no ONIE for the NXP LX2160ARDB yet."
+    echo "Install from Linux, see docs/sonic-lx2160-bringup.md in lx2160-sonic."
+    exit 1
 fi
+
+bootloader_menu_config()
+{
+    # sonic-installer makes the new image the default afterwards if asked
+    [ "$install_env" = "sonic" ] || return 0
+    lx2160_uboot_env "$demo_mnt" "$image_dir" "$demo_volume_revision_label" once
+}
