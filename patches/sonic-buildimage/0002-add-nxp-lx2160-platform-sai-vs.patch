diff --git a/platform/nxp-lx2160/platform_arm64.conf b/platform/nxp-lx2160/platform_arm64.conf
new file mode 100644
index 000000000..c070e7e2b
--- /dev/null
+++ b/platform/nxp-lx2160/platform_arm64.conf
@@ -0,0 +1,22 @@
+# SONiC installer platform hooks for the NXP LX2160ARDB.
+#
+# Not implemented yet: this board has no ONIE, and the generic installer's
+# partitioning and U-Boot environment handling have not been adapted to it.
+# Refuse to install rather than let default_platform.conf partition a disk.
+# Bring-up installs the image by hand (lx2160-sonic: scripts/sonic-lx2160-install.sh,
+# then boot from U-Boot as described in docs/sonic-lx2160-bringup.md).
+
+lx2160_not_supported()
+{
+    echo "SONiC installer: the NXP LX2160ARDB installer is not implemented yet."
+    echo "Install manually, see docs/sonic-lx2160-bringup.md in lx2160-sonic."
+    exit 1
+}
+
+create_partition()      { lx2160_not_supported; }
+mount_partition()       { lx2160_not_supported; }
+bootloader_menu_config() { lx2160_not_supported; }
+
+if [ "$install_env" != "build" ]; then
+    lx2160_not_supported
+fi
