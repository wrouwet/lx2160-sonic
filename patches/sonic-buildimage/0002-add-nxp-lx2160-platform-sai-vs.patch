@@ -0,0 +1,14 @@
+# Stable names for the LX2160ARDB DPAA2 interfaces. The DPNI numbers come
+# from the DPL (firmware/dpl/dpl-lx2160ardb-sonic.dts in lx2160-sonic):
+#   dpni.0 -> dpmac17 (RGMII 1G)        front-panel port, SONiC Ethernet0
+#   dpni.1 -> dpmac2  (40G QSFP)        SONiC management port eth0 (uncabled)
+#   dpni.2 -> dpmac18 (RGMII 1G)        front-panel port, SONiC Ethernet4
+#   dpni.3 -> dpmac3  (AQR107 10GBASE-T) front-panel port, SONiC Ethernet8
+#   dpni.4 -> dpmac4  (AQR107 10GBASE-T) front-panel port, SONiC Ethernet12
+# Front-panel ports get dpmacNN names (never ethN) so the kernel's ethN
+# probe-order names cannot collide; lanemap.ini binds these names to lanes.
+SUBSYSTEM=="net", ACTION=="add", KERNELS=="dpni.0", NAME="dpmac17"
+SUBSYSTEM=="net", ACTION=="add", KERNELS=="dpni.2", NAME="dpmac18"
+SUBSYSTEM=="net", ACTION=="add", KERNELS=="dpni.3", NAME="dpmac3"
+SUBSYSTEM=="net", ACTION=="add", KERNELS=="dpni.4", NAME="dpmac4"
+SUBSYSTEM=="net", ACTION=="add", KERNELS=="dpni.1", NAME="eth0"
diff --git a/platform/nxp-lx2160/sonic_fit.its b/platform/nxp-lx2160/sonic_fit.its
new file mode 100644
index 000000000..e05726108
--- /dev/null
+++ b/platform/nxp-lx2160/sonic_fit.its
@@ -0,0 +1,62 @@
+/dts-v1/;
+/*
+ * U-Boot FIT image for SONiC on the NXP LX2160ARDB (LX2160A rev2).
+ * __KERNEL_PATH__/__INITRD_PATH__ are filled in by build_debian.sh. The DTB
+ * path names the kernel version explicitly (no placeholder resolves to
+ * freescale/); update it together with the SONiC kernel version.
+ * LX2160A DRAM starts at 0x80000000; kernel at +2 MiB, DTB and initrd above it.
+ */
+/ {
+    description = "U-Boot fitImage for SONiC on NXP LX2160ARDB";
+    #address-cells = <1>;
+
+    images {
+        kernel_lx2160 {
+            description = "SONiC Linux kernel";
+            data = /incbin/("__KERNEL_PATH__");
+            type = "kernel";
+            arch = "arm64";
+            os = "linux";
+            compression = "none";
+            load = <0x80200000>;
+            entry = <0x80200000>;
+            hash@1 {
+                algo = "sha1";
+            };
+        };
+        fdt_lx2160ardb {
+            description = "LX2160ARDB device tree";
+            data = /incbin/("/usr/lib/linux-image-6.12.41+deb13-sonic-arm64/freescale/fsl-lx2160a-rdb.dtb");
+            type = "flat_dt";
+            arch = "arm64";
+            compression = "none";
+            load = <0x8fc00000>;
+            hash@1 {
+                algo = "sha1";
+            };
+        };
+        ramdisk_lx2160 {
+            description = "SONiC initramfs";
+            data = /incbin/("__INITRD_PATH__");
+            type = "ramdisk";
+            arch = "arm64";
+            os = "linux";
+            compression = "none";
+            load = <0x90000000>;
+            entry = <0x90000000>;
+            hash@1 {
+                algo = "sha1";
+            };
+        };
+    };
+
+    configurations {
+        default = "conf_lx2160ardb";
+        conf_lx2160ardb {
+            description = "NXP LX2160ARDB";
+            kernel = "kernel_lx2160";
+            fdt = "fdt_lx2160ardb";
+            ramdisk = "ramdisk_lx2160";
+        };
+    };
+};
diff --git a/platform/nxp-lx2160/syncd-vs.dep b/platform/nxp-lx2160/syncd-vs.dep
