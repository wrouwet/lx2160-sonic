--- a/platform/nxp-lx2160/syncd-vs.mk	2026-11-22 04:13:41.735409484 -0600
+++ b/platform/nxp-lx2160/syncd-vs.mk	2026-11-22 04:13:41.739358179 -0600
@@ -3,18 +3,9 @@
 SYNCD_VS = syncd-vs_1.0.0_$(CONFIGURED_ARCH).deb
 $(SYNCD_VS)_RDEPENDS += $(LIBSAIREDIS) $(LIBSAIMETADATA) $(LIBSAIVS)
 
-ifeq ($(INCLUDE_VS_DASH_SAI),y)
-ifneq ($(findstring $(BLDENV), bookworm trixie), )
-# dash-sai only support sonic-vs.img.gz. it don't support docker-sonic-vs.gz
-ifeq ($(findstring docker-sonic-vs, $(SONIC_BUILD_TARGET) $(EXTRA_DOCKER_TARGETS)), )
-  $(LIBSAIREDIS)_DEB_BUILD_PROFILES += dashsai
-  $(LIBSAIREDIS)_DEPENDS += $(DASH_SAI)
-  $(SYNCD_VS)_RDEPENDS += $(DASH_SAI)
-endif
-else
-  $(warning DASH_SAI cannot support this build environment $(BLDENV))
-endif
-endif
+# No DASH SAI on the LX2160ARDB: SAI-VS emulates a switch ASIC here, not a
+# DPU. DASH pulls in p4lang (pi/bmv2/p4c), whose gRPC build dependencies the
+# sonic-slave image only installs on amd64.
 
 $(eval $(call add_derived_package,$(LIBSAIREDIS),$(SYNCD_VS)))
 
