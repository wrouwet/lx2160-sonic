# Kernel options Docker needs that NXP's defconfig + lsdk.config leave out.
# All modules, so the built-in kernel (Image) does not change.
#
# Debian uses iptables-nft, so Docker's nat/filter tables are nftables tables
# (NFT_NAT, NFT_COMPAT, NFT_MASQ are built in). What was missing is the xt
# MASQUERADE target that its POSTROUTING rule uses through nft_compat.
# The legacy IP_NF_* tables that Docker's check-config.sh still lists would
# need NETFILTER_XTABLES_LEGACY (built in) and are not needed with iptables-nft.
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_NAT_FTP=m
CONFIG_NF_NAT_TFTP=m
CONFIG_DUMMY=m
